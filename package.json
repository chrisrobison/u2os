{
  "name": "u2os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "U2OS — the user-owned operating system for your digital self.",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.js",
    "seed": "node server/seed/seed.js",
    "backup": "node server/backup/snapshot.js backup",
    "restore": "node server/backup/snapshot.js restore",
    "maintain": "node server/events/maintenance-cli.js",
    "setup-owner": "node server/security/setup-owner-cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "js-yaml": "^4.1.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
