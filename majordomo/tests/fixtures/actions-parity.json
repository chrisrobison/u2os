   "trigger": "expire_lease",
   "rust": "outcome_uncertain",
   "node": "leased",
   "note": "DIFFERENCE: Node re-leases an executing action whose lease expired (the worker later refuses to retry a non-idempotent tool); Rust never leases it again and parks it as outcome_uncertain."
  },
