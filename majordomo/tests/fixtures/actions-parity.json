 "scenarios": [
  {
   "name": "duplicate submit never resets an existing action",
   "steps": [
    {
     "op": "enqueue",
     "at": 0,
     "expect": {
      "ok": true,
      "status": "queued",
      "next_attempt_at": 0
     }
    },
    {
     "op": "lease",
     "at": 1000,
     "owner": "a",
     "leaseMs": 30000,
     "expect": {
      "ok": true,
      "status": "leased",
      "owner": "a"
     }
    },
    {
     "op": "enqueue",
     "at": 2000,
     "expect": {
      "ok": true,
      "status": "leased",
      "owner": "a"
     }
    }
   ]
  },
  {
   "name": "only one tick can lease a due action",
   "steps": [
    {
     "op": "enqueue",
     "at": 0,
     "expect": {}
    },
    {
     "op": "lease",
     "at": 1000,
     "owner": "a",
     "leaseMs": 30000,
     "expect": {
      "ok": true,
      "status": "leased",
      "owner": "a"
     }
    },
    {
     "op": "lease",
     "at": 1000,
     "owner": "b",
     "leaseMs": 30000,
     "expect": {
      "ok": false,
      "status": "leased",
      "owner": "a"
     }
    }
   ]
  },
  {
   "name": "lease expiry boundary is inclusive",
   "steps": [
    {
     "op": "enqueue",
     "at": 0,
     "expect": {}
    },
    {
     "op": "lease",
     "at": 1000,
     "owner": "a",
     "leaseMs": 1000,
     "expect": {
      "ok": true,
      "status": "leased",
      "owner": "a"
     }
    },
    {
     "op": "lease",
     "at": 1999,
     "owner": "c",
     "leaseMs": 1000,
     "expect": {
      "ok": false,
      "status": "leased",
      "owner": "a"
     }
    },
    {
     "op": "lease",
     "at": 2000,
     "owner": "c",
     "leaseMs": 1000,
     "expect": {
      "ok": true,
      "status": "leased",
      "owner": "c"
     }
    }
   ]
  },
  {
   "name": "retry backoff then dead letter",
   "steps": [
    {
     "op": "enqueue",
     "at": 0,
     "expect": {}
    },
    {
     "op": "lease",
     "at": 1000,
     "owner": "a",
     "leaseMs": 30000,
     "expect": {
      "ok": true,
      "status": "leased",
      "owner": "a"
     }
    },
    {
     "op": "begin",
     "at": 1500,
     "owner": "a",
     "expect": {
      "ok": true,
      "status": "executing"
     }
    },
    {
     "op": "fail",
     "at": 3000,
     "owner": "a",
     "errorClass": "retryable",
     "maxAttempts": 2,
     "expect": {
      "ok": true,
      "status": "retry_wait",
      "owner": null,
      "next_attempt_at": 4000
     }
    },
    {
     "op": "lease",
     "at": 3999,
     "owner": "b",
     "leaseMs": 30000,
     "expect": {
      "ok": false,
      "status": "retry_wait"
     }
    },
    {
     "op": "lease",
     "at": 4000,
     "owner": "b",
     "leaseMs": 30000,
     "expect": {
      "ok": true,
      "status": "leased",
      "owner": "b"
     }
    },
    {
     "op": "begin",
     "at": 4100,
     "owner": "b",
     "expect": {
      "ok": true,
      "status": "executing"
     }
    },
    {
     "op": "fail",
     "at": 5000,
     "owner": "b",
     "errorClass": "retryable",
     "maxAttempts": 2,
     "expect": {
      "ok": true,
      "status": "dead_letter",
      "owner": null
     }
    }
   ]
  },
  {
   "name": "non-retryable failure is terminal",
   "steps": [
    {
     "op": "enqueue",
     "at": 0,
     "expect": {}
    },
    {
     "op": "lease",
     "at": 1000,
     "owner": "a",
     "leaseMs": 30000,
     "expect": {}
    },
    {
     "op": "begin",
     "at": 1100,
     "owner": "a",
     "expect": {}
    },
    {
     "op": "fail",
     "at": 1200,
     "owner": "a",
     "errorClass": "non_retryable",
     "maxAttempts": 5,
     "expect": {
      "ok": true,
      "status": "failed",
      "owner": null
     }
    }
   ]
  },
  {
   "name": "an attempt settles once and only for its owner",
   "steps": [
    {
     "op": "enqueue",
     "at": 0,
     "expect": {}
    },
    {
     "op": "lease",
     "at": 1000,
     "owner": "a",
     "leaseMs": 30000,
     "expect": {}
    },
    {
     "op": "begin",
     "at": 1100,
     "owner": "a",
     "expect": {
      "ok": true,
      "status": "executing"
     }
    },
    {
     "op": "complete",
     "at": 1200,
     "owner": "b",
     "expect": {
      "ok": false,
      "status": "executing",
      "owner": "a"
     }
    },
    {
     "op": "complete",
     "at": 1300,
     "owner": "a",
     "expect": {
      "ok": true,
      "status": "completed",
      "owner": null
     }
    },
    {
     "op": "complete",
     "at": 1400,
     "owner": "a",
     "expect": {
      "ok": false,
      "status": "completed"
     }
    }
   ]
  },
  {
   "name": "executing at crash",
   "steps": [
    {
     "op": "enqueue",
     "at": 0,
     "expect": {}
    },
    {
     "op": "lease",
     "at": 1000,
     "owner": "old",
     "leaseMs": 1000,
     "expect": {
      "ok": true,
      "status": "leased",
      "owner": "old"
     }
    },
    {
     "op": "begin",
     "at": 1500,
     "owner": "old",
     "expect": {
      "ok": true,
      "status": "executing"
     }
    },
    {
     "op": "lease",
     "at": 3000,
     "owner": "new",
     "leaseMs": 30000,
     "expect": {},
     "expect_rust": {
      "ok": false,
      "status": "outcome_uncertain",
      "owner": null
     },
     "expect_node": {
      "ok": true,
      "status": "leased",
      "owner": "new"
     },
     "note": "DIFFERENCE: Node re-leases the abandoned execution; Rust parks it as outcome_uncertain and never leases it."
    }
   ]
  }
 ]
}
