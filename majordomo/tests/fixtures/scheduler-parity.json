{
 "description": "Shared by tests/majordomo-parity-scheduler.test.js (Node's real dueSlot/parseTrigger/runner) and majordomo/tests/scheduler_parity.rs. Statuses: 'ran' is Node 'completed' / Rust 'enqueued'.",
 "differences": [
  {
   "area": "time zone",
   "node": "process-local zone via JS Date (TZ env)",
   "rust": "injected Zone (fixed offset or US DST rules); the fixture gives both",
   "note": "Rust has no IANA database in this build"
  },
  {
   "area": "throttle event",
   "node": "routine.failed with reason hourly_routine_limit",
   "rust": "same (there is no routine.throttled in Node)"
  },
  {
   "area": "cap clock",
   "node": "Date.now(), ignoring the tick's now",
   "rust": "the injected clock"
  },
  {
   "area": "lease",
   "node": "none in the routine runner (claims dedupe); trigger-engine leases rows",
   "rust": "one lease row so a single ticker fires; claims still dedupe"
  },
  {
   "area": "enqueue",
   "node": "runs the agent in-process",
   "rust": "creates a mock routine.run action with key routine:<routine>:<slot>; repaired by recover() after a crash"
  }
 ],
