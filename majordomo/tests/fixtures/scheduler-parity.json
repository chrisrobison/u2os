 "scenarios": [
  {
   "name": "slots are claimed once; late ticks claim only the current slot",
   "tz": "America/Los_Angeles",
   "zone": "us:-480",
   "routines": [
    {
     "path": "a.md",
     "when": {
      "daily": "07:00",
      "days": [
       "mon",
       "tue",
       "wed",
       "thu",
       "fri"
      ]
     }
    },
    {
     "path": "b.md",
     "when": {
      "every_minutes": 15
     }
    }
   ],
   "steps": [
    {
     "op": "tick",
     "now": "2026-09-28T14:05:00Z",
     "expect": [
      {
       "routine": "a.md",
       "slot": "daily:2026-09-28",
       "status": "ran"
      },
      {
       "routine": "b.md",
       "slot": "every:15:1989560",
       "status": "ran"
      }
     ]
    },
    {
     "op": "tick",
     "now": "2026-09-28T14:06:00Z",
     "expect": [],
     "note": "same slots: nothing runs"
    },
    {
     "op": "tick",
     "now": "2026-09-28T14:15:00Z",
     "expect": [
      {
       "routine": "b.md",
       "slot": "every:15:1989561",
       "status": "ran"
      }
     ]
    },
    {
     "op": "tick",
     "now": "2026-09-28T20:00:00Z",
     "expect": [
      {
       "routine": "b.md",
       "slot": "every:15:1989584",
       "status": "ran"
      }
     ],
     "note": "hours of downtime: no catch-up, the 07:00 brief is not replayed and the missed 15-minute windows are skipped"
    },
    {
     "op": "tick",
     "now": "2026-09-29T14:00:00Z",
     "expect": [
      {
       "routine": "a.md",
       "slot": "daily:2026-09-29",
       "status": "ran"
      },
      {
       "routine": "b.md",
       "slot": "every:15:1989656",
       "status": "ran"
      }
     ]
    }
   ]
  },
  {
