      }
     },
     "expect": [
      {
       "routine": "mail.md",
       "slot": "event:evt_1",
       "status": "ran"
      }
     ]
    },
    {
     "op": "event",
     "event": {
      "id": "evt_1",
      "type": "email.received",
      "data": {
       "after": {
        "from": "jo@NorthwindTalent.example"
       }
      }
     },
     "expect": [],
     "note": "redelivery of the same event"
    },
    {
     "op": "event",
     "event": {
      "id": "evt_2",
      "type": "email.received",
      "data": {
       "after": {
        "from": "mom@example.com"
       }
      }
     },
     "expect": []
    },
    {
     "op": "event",
     "event": {
      "id": "evt_3",
      "type": "calendar.event_added",
      "data": {
       "after": {
        "from": "talent"
       }
      }
     },
     "expect": []
    },
    {
     "op": "tick",
     "now": "2026-09-28T14:05:00Z",
     "expect": [],
     "note": "event routines are not time-scheduled"
    }
   ]
  },
  {
   "name": "hourly cap of 30; throttled rows do not count; manual is never throttled",
   "tz": "UTC",
   "zone": "fixed:0",
   "routines": [
    {
     "path": "any.md",
     "when": {
      "event": "thing.happened"
     }
    }
   ],
   "steps": [
    {
     "op": "events",
     "prefix": "evt_",
     "from": 0,
     "count": 32,
     "type": "thing.happened",
     "expect_ran": 30,
     "expect_throttled": 2
    },
    {
     "op": "event",
     "event": {
      "id": "evt_30",
      "type": "thing.happened",
      "data": {}
     },
     "expect": [],
     "note": "a throttled slot stays claimed"
    },
    {
     "op": "manual",
     "routine": "any.md",
     "expect": [
      {
       "routine": "any.md",
       "slot": "manual:*",
       "status": "ran"
      }
     ]
    },
    {
     "op": "event",
     "event": {
      "id": "evt_32",
      "type": "thing.happened",
      "data": {}
     },
     "expect": [
      {
       "routine": "any.md",
       "slot": "event:evt_32",
       "status": "throttled"
      }
     ]
    },
    {
     "op": "age_runs",
     "ms": 3700000
    },
    {
     "op": "event",
     "event": {
      "id": "evt_33",
      "type": "thing.happened",
      "data": {}
     },
     "expect": [
      {
       "routine": "any.md",
       "slot": "event:evt_33",
       "status": "ran"
      }
     ],
     "note": "runs older than an hour leave the window"
    }
   ]
  }
 ]
